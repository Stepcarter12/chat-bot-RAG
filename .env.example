# ── .env.example — Template biến môi trường cho Phase 9 ──────────────────────
# Sao chép file này thành .env và điền giá trị thực
# cp .env.example .env

# ── Groq LLM (bắt buộc) ────────────────────────────────────────────────────
# Lấy tại: https://console.groq.com/keys
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── PostgreSQL — LangGraph persistent state ─────────────────────────────────
# Trong Docker: host là tên service "postgres"
# Local dev:    host là "localhost"
DATABASE_URL=postgresql://chatbot:chatbot_pass@postgres:5432/chatbot_db
POSTGRES_USER=chatbot
POSTGRES_PASSWORD=chatbot_pass
POSTGRES_DB=chatbot_db

# ── Redis + Celery ──────────────────────────────────────────────────────────
# Trong Docker: host là tên service "redis"
# Local dev:    host là "localhost"
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# ── Facebook Messenger ──────────────────────────────────────────────────────
# FB_VERIFY_TOKEN: chuỗi tự đặt khi cấu hình webhook tại Meta App Dashboard
#   → Phải khớp với giá trị bạn nhập vào ô "Verify Token" trên Facebook
#   → Đặt bất kỳ chuỗi ngẫu nhiên nào, ví dụ: openssl rand -hex 16
FB_VERIFY_TOKEN=your_custom_verify_token_here

# FB_APP_SECRET: lấy từ Meta App Dashboard → Settings → Basic → App Secret
FB_APP_SECRET=your_facebook_app_secret_here

# FB_PAGE_ACCESS_TOKEN: lấy từ Meta App Dashboard → Messenger → Settings → Access Token
#   Cần cấp quyền: pages_messaging, pages_manage_metadata
FB_PAGE_ACCESS_TOKEN=EAAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Flower Monitoring Dashboard (http://localhost:5555) ─────────────────────
# Basic auth để bảo vệ dashboard (hiển thị task args, có thể chứa SĐT khách)
FLOWER_USER=admin
FLOWER_PASSWORD=changeme

# ── Google Sheets — Lưu leads ───────────────────────────────────────────────
# GOOGLE_SHEET_ID: lấy từ URL của Google Sheet
# GOOGLE_CREDENTIALS_PATH: đường dẫn tới file service account key JSON
GOOGLE_SHEET_ID=your_google_sheet_id_here
GOOGLE_CREDENTIALS_PATH=/app/google_credentials.json

# ── Production Domain (Phase 14) ────────────────────────────────────────────
# Domain thật trỏ về VPS — dùng để cấu hình nginx và CORS
# Ví dụ: DOMAIN=chatbot.myshop.com
DOMAIN=your.domain.com

# ── Messenger Embedding & Rate Limiting ─────────────────────────────────────
# Embedding model dùng cho Messenger: "vi" (Tiếng Việt) hoặc "en" (Tiếng Anh)
MESSENGER_EMBEDDING_TYPE=vi
# Số tin nhắn tối đa mỗi PSID được gửi trong 1 phút (chống spam)
MESSENGER_RATE_LIMIT_PER_MIN=10

# ── CORS Origins ─────────────────────────────────────────────────────────────
# Dev:        CORS_ORIGINS=*
# Production: CORS_ORIGINS=https://your.domain.com
CORS_ORIGINS=*

# ── Streamlit → API URL ─────────────────────────────────────────────────────
# Trong Docker Compose: dùng service name "api"
# Local dev: để trống hoặc không khai báo (mặc định http://127.0.0.1:8080)
API_BASE_URL=http://api:8080
